# ===========================================
# Build-time placeholders for CI/CD
# These values are baked into the build and replaced at runtime by
# entrypoint.sh with the real container environment variables, so the
# same image can be deployed to several environments.
#
# Base path convention: at runtime set BASE_PATH and NEXT_PUBLIC_BASE_PATH to
# "" for a root deploy, or to "/segment" WITH a leading slash for a sub-path
# (e.g. BASE_PATH=/business-center). entrypoint.sh strips the whole token so an
# empty value yields a clean root.
# ===========================================

# --- Non NEXT_PUBLIC (replaced explicitly) ---
DOMAIN_NAME=DOMAIN_NAME_PLACEHOLDER
BASE_PATH=/BASE_PATH_PLACEHOLDER
HEALTH_AUTH="false"
HEALTH_USERNAME=HEALTH_USERNAME_PLACEHOLDER
HEALTH_PASSWORD=HEALTH_PASSWORD_PLACEHOLDER

# --- App ---
NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL_PLACEHOLDER
NEXT_PUBLIC_APP_NAME=NEXT_PUBLIC_APP_NAME_PLACEHOLDER
NEXT_PUBLIC_BASE_PATH=NEXT_PUBLIC_BASE_PATH_PLACEHOLDER
NEXT_PUBLIC_INACTIVITY_WARNING_TIMEOUT=NEXT_PUBLIC_INACTIVITY_WARNING_TIMEOUT_PLACEHOLDER
NEXT_PUBLIC_INACTIVITY_COUNTDOWN_TIMEOUT=NEXT_PUBLIC_INACTIVITY_COUNTDOWN_TIMEOUT_PLACEHOLDER

# --- Feature flags ---
NEXT_PUBLIC_USE_MANDATES=NEXT_PUBLIC_USE_MANDATES_PLACEHOLDER
NEXT_PUBLIC_USE_DECISIONS=NEXT_PUBLIC_USE_DECISIONS_PLACEHOLDER

# --- Alert banner (optional) ---
NEXT_PUBLIC_ALERT_BANNER_MESSAGE=NEXT_PUBLIC_ALERT_BANNER_MESSAGE_PLACEHOLDER
NEXT_PUBLIC_ALERT_BANNER_SEVERITY=NEXT_PUBLIC_ALERT_BANNER_SEVERITY_PLACEHOLDER

# --- Matomo (optional) ---
NEXT_PUBLIC_MATOMO_URL=NEXT_PUBLIC_MATOMO_URL_PLACEHOLDER
NEXT_PUBLIC_MATOMO_SITE_ID=NEXT_PUBLIC_MATOMO_SITE_ID_PLACEHOLDER
