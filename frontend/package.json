{
  "name": "@sk-web-gui/web-app-business-center",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/generate-data-contracts.ts",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "knip": "knip",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "npx cypress run --e2e",
    "jest": "jest --watch",
    "jest:ci": "jest --runInBand",
    "jest:coverage": "jest --coverage",
    "test": "concurrently \"yarn jest\" \"yarn cypress\"",
    "type-check": "next typegen && tsc --pretty --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/bundle-analyzer": "16.2.12",
    "@react-hookz/web": "^25.2.0",
    "@sk-web-gui/card": "^2.0.3",
    "@sk-web-gui/core": "^4.6.2",
    "@sk-web-gui/react": "^3.1.3",
    "@socialgouv/matomo-next": "1.11.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^25.6.0",
    "i18next-resources-to-backend": "^1.2.3",
    "is-mobile": "^5.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-i18n-router": "^5.5.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^16.2.4",
    "sanitize-html": "^2.17.7",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.2.3",
    "baseline-browser-mapping": "^2.11.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.1",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.3.0",
    "swagger-typescript-api": "^13.12.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,css,json}": [
      "prettier --write"
    ]
  }
}
